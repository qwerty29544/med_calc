# Скопируйте в .env.demo на сервере. Файл .env.demo не попадает в Git или образ.
# Пароль PostgreSQL: сгенерируйте командой openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-random-hex-password
WEB_PORT=8080
# Адрес, который тестировщики открывают в браузере: схема + хост + порт, без / в конце.
# Для нескольких адресов используйте список через запятую.
APP_ORIGIN=https://calc.example.ru
