{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdss:rule-engine:evaluation-request:0.1.0",
  "title": "Rule Engine Evaluation Request v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "ruleset_version",
    "case_snapshot",
    "options"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "ruleset_version": {
      "type": "string",
      "minLength": 1
    },
    "ruleset_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "case_snapshot": {
      "$ref": "#/$defs/PatientCase"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_trace",
        "strict_mode"
      ],
      "properties": {
        "include_trace": {
          "type": "boolean"
        },
        "strict_mode": {
          "type": "boolean"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  },
  "$defs": {
    "FactValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "KNOWN",
            "UNKNOWN",
            "NOT_ASSESSED"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "number",
            "integer",
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source": {
          "enum": [
            "MANUAL",
            "IMPORTED",
            "CALCULATED",
            "UNKNOWN"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "KNOWN"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "UNKNOWN",
                  "NOT_ASSESSED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "PatientCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "case_id",
        "captured_at",
        "nosology_code",
        "facts"
      ],
      "properties": {
        "contract_version": {
          "const": "0.1.0"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "patient_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "nosology_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "facts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/FactValue"
          }
        },
        "concomitant_drug_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      },
      "$defs": {
        "FactValue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "enum": [
                "KNOWN",
                "UNKNOWN",
                "NOT_ASSESSED"
              ]
            },
            "value": {
              "type": [
                "boolean",
                "number",
                "integer",
                "string",
                "null"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "observed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "source": {
              "enum": [
                "MANUAL",
                "IMPORTED",
                "CALCULATED",
                "UNKNOWN"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "KNOWN"
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "UNKNOWN",
                      "NOT_ASSESSED"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}