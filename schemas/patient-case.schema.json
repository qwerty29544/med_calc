{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdss:rule-engine:patient-case:0.1.0",
  "title": "Patient Case Snapshot v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "case_id",
    "captured_at",
    "nosology_code",
    "facts"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "patient_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "nosology_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "facts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/FactValue"
      }
    },
    "concomitant_drug_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "FactValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "KNOWN",
            "UNKNOWN",
            "NOT_ASSESSED"
          ]
        },
        "value": {
          "type": [
            "boolean",
            "number",
            "integer",
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source": {
          "enum": [
            "MANUAL",
            "IMPORTED",
            "CALCULATED",
            "UNKNOWN"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "KNOWN"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "UNKNOWN",
                  "NOT_ASSESSED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}